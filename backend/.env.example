# CampusClaw 后端环境变量模板
# 使用方法：复制本文件为 .env（cp .env.example .env）再填写真实值。
# 注意：本文件不含任何真实密钥，可安全提交到 GitHub；
# 真实 .env 已被 .gitignore 排除，绝不会被提交。

# ==== 数据库 ====
# 本地开发默认用相对路径；Docker 部署用 sqlite:////app/data/campusclaw.db
DATABASE_URL=sqlite:///./campusclaw.db

# ==== JWT ====
# 生产环境务必改为一个足够随机且仅你自己知道的超长字符串
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMP_TOKEN_EXPIRE_MINUTES=5

# ==== 短信验证码（开发阶段为 Mock，验证码直接写在 API 响应里）====
SMS_MOCK=true

# ==== 学校缩写（初始密码规则：xxx + 学号/工号后 6 位）====
SCHOOL_ABBR=thu

# ==== 生产环境交互式文档开关（/docs、/redoc、/openapi.json）====
ENABLE_DOCS=false

# ==== CORS 允许的前端来源（多个用英文逗号分隔）====
FRONTEND_ORIGINS=http://localhost:3000

# ==== Cookie ====
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ==== 材料上传 ====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,pptx,docx,jpg,png

# ==== RAG 检索（add-rag-search）====
CHUNK_SIZE=500
CHUNK_OVERLAP=100
CHUNK_TOP_K=5
EMBED_DIM=512

# ==== AI 解题助手（DeepSeek，openai 兼容）====
# 请替换为你在 platform.deepseek.com 申请的 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_TEMPERATURE=0.3